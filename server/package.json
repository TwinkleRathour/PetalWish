{
  "name": "petalwish-server",
  "version": "1.0.0",
  "description": "PetalWish backend: Express REST API with MongoDB (Mongoose) and JWT authentication",
  "type": "module",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch-path=src --watch-path=.env src/server.js",
    "dev:memory": "node --watch-path=src --watch-path=scripts scripts/dev-memory.js",
    "seed": "node scripts/seed.js",
    "extract-templates": "node scripts/extract-templates.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1"
  }
}
