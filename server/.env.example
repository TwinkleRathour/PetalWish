# Copy this file to `.env` (same folder) and fill in the values. Never commit `.env`.

NODE_ENV=development
PORT=5000

# MongoDB Atlas → Database → Connect → Drivers → copy the connection string.
# Put the database name ("petalwish") after the host, before the "?".
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-name>.xxxxx.mongodb.net/petalwish?retryWrites=true&w=majority&appName=PetalWish

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Browser origins allowed to call the API (comma separated): Vite dev server, deployed frontend…
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5000,http://localhost:8000

BCRYPT_SALT_ROUNDS=12

# Serve the existing index.html/style.css/script.js from this server at http://localhost:5000
SERVE_FRONTEND=true

# Insert the 40 bundled templates automatically if the templates collection is empty
AUTO_SEED_TEMPLATES=true

# Image uploads (multer). Files are saved in server/uploads/ unless UPLOAD_DIR is set.
MAX_UPLOAD_MB=5
# UPLOAD_DIR=
# Public address of this server, used in links to uploaded images when deployed
# PUBLIC_URL=https://your-api.example.com

# Optional: `npm run seed` creates (or promotes) this admin account
ADMIN_NAME=PetalWish Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Added by the payment module (Member 2) ----
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
